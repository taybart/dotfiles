; vim: ft=gitconfig

[alias]
  ls = log --graph --abbrev-commit --decorate --all --color=always --date=relative --format=format:'%C(bold blue)%h - %C(bold green)(%ar) %C(reset)%s - %C(magenta)%an%C(bold yellow)%d'
  c = commit
  s = status
  p = push
  co = checkout
  br = branch
  st = stash
	pushf = push --force-with-lease

  # Log, in a single-line format
  lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
  # List branches in most-recently-modified order
  recent = for-each-ref --sort='-authordate:iso8601' --format='%(authordate:relative)%09%(refname:short)' refs/heads
  # FIXME Roulette!
  fixme-roulette = "!f() { \
      echo 'Abandon hope, all ye who enter here!'; \
      git grep -Ein '(FIXME|TODO)' | shuf -n1; \
  }; f"
[push]
  default = current
[pull]
	rebase = false
[init]
  defaultBranch = main

[include]
  path = ~/.gitconfig.local
[branch]
	sort = -committerdate
